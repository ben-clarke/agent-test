{
  "name": "library-books",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "test": "pnpm -r test",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm -r typecheck",
    "test:e2e": "pnpm --filter @library/web test:e2e"
  },
  "devDependencies": {
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.15.0"
}
